# Copy to .env and adjust. .env is gitignored.

# --- Database -------------------------------------------------------------
# PostgreSQL is required. Create the database first:
#   createdb -U postgres wireless_monitor
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wireless_monitor

# --- Flask ----------------------------------------------------------------
SECRET_KEY=change-me
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# Comma-separated origins, or * for any. The Vite dev server is :5173.
CORS_ORIGINS=*

# --- Scanner --------------------------------------------------------------
# Seconds between scans. The value stored in scan_settings wins once set.
SCAN_INTERVAL=10

# auto | netsh | nmcli | iwlist
# auto picks netsh on Windows and nmcli/iwlist on Linux.
SCANNER_BACKEND=auto

# Leave blank to auto-detect. On Windows this is a name like "Wi-Fi";
# on Linux something like wlan0.
WIFI_INTERFACE=

# Start the continuous monitor as soon as the backend boots.
AUTO_START_MONITORING=true

# Per-network retention cap for signal_readings. 0 = keep every reading.
SIGNAL_HISTORY_LIMIT=0
